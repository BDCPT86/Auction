{
  "name": "draft-day-tests",
  "private": true,
  "description": "Automated checks for Draft Day. The app itself needs none of this: it runs straight from index.html.",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "lint": "eslint -c ../eslint.config.js --no-config-lookup ../event.config.js ../js",
    "format": "prettier --write ../event.config.js \"../js/**/*.js\" ../styles.css \"*.js\"",
    "format:check": "prettier --check ../event.config.js \"../js/**/*.js\" ../styles.css \"*.js\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "espree": "^10.4.0",
    "globals": "^16.5.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.0"
  }
}
