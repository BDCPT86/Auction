{
  "name": "draft-day-tests",
  "private": true,
  "description": "Automated checks for Draft Day. The app itself needs none of this: it runs straight from index.html.",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "lint": "eslint -c ../eslint.config.js --no-config-lookup ../ui.js ../event.config.js ../setup.js ../app.js ../projector.js ../alloc.js",
    "format": "prettier --write \"../*.js\" ../styles.css",
    "format:check": "prettier --check \"../*.js\" ../styles.css"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "espree": "^10.4.0",
    "globals": "^16.5.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.0"
  }
}
